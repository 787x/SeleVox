<Window x:Class="SeleVox.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SeleVox · 选区朗读" Width="620" Height="820" MinWidth="500" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#F5F7FA">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="服务检测" Click="Diagnostics_Click" Padding="8,3" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock Text="SeleVox" FontSize="28" FontWeight="SemiBold" Foreground="#193B56"/>
            </DockPanel>
            <TextBlock Text="选择文字，按 Ctrl+Alt+R 朗读。" Margin="0,8,0,22" FontSize="15"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
            <TextBlock Text="屏幕框选 OCR · Ctrl+Alt+O（离线，不自动复制或朗读）" TextWrapping="Wrap" Margin="0,0,0,6"/>
            <ComboBox x:Name="OcrLanguageChoice" Height="32" Margin="0,0,0,16">
                <ComboBoxItem Content="简体中文 + 英文"/><ComboBoxItem Content="英文"/>
            </ComboBox>
            <TextBlock Text="TTS Provider" Margin="0,0,0,6"/>
            <ComboBox x:Name="Provider" Height="32" SelectionChanged="Provider_Changed">
                <ComboBoxItem Content="Windows 本地 TTS（离线）"/><ComboBoxItem Content="Azure Speech TTS（发送选区到云端）"/>
                <ComboBoxItem Content="Edge 在线自然语音（实验性，需要联网）"/>
                <ComboBoxItem Content="MiMo TTS（发送选区到小米）"/>
                <ComboBoxItem Content="OpenAI-Compatible TTS（发送选区到配置服务）"/>
            </ComboBox>
            <StackPanel x:Name="LocalPanel">
            <Grid Margin="0,12,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Windows 本地语音" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"><Hyperlink x:Name="WindowsDiagnosticLink" Tag="Windows" Click="InlineDiagnostic_Click" Foreground="#193B56" TextDecorations="{x:Null}" ToolTip="检测已保存配置；在线调用可能收费。">检测</Hyperlink></TextBlock>
                </Grid>
            <ComboBox x:Name="Voice" DisplayMemberPath="Label" SelectedValuePath="Id" Height="32"/>
            </StackPanel>
            <StackPanel x:Name="AzurePanel" Visibility="Collapsed">
                <TextBlock Text="Azure Region（例如 eastasia）" Margin="0,12,0,4"/>
                <TextBox x:Name="Region" Height="28" TextChanged="AzureRegion_Changed"/>
                <Grid Margin="0,10,0,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Azure Speech Key（存入 Windows 凭据管理器）" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"><Hyperlink x:Name="AzureDiagnosticLink" Tag="Azure" Click="InlineDiagnostic_Click" Foreground="#193B56" TextDecorations="{x:Null}" ToolTip="检测已保存配置；在线调用可能收费。">检测</Hyperlink></TextBlock>
                </Grid>
                <PasswordBox x:Name="AzureKey" Height="28"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="保存 / 更新 Key" Click="SaveKey_Click" Padding="8,4" Margin="0,0,8,0"/>
                    <Button Content="清除 Key" Click="ClearKey_Click" Padding="8,4"/>
                </StackPanel>
                <TextBlock x:Name="CredentialStatus" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <Button x:Name="QueryVoices" Content="查询此 Region 可用语音" Click="QueryVoices_Click" HorizontalAlignment="Left" Padding="8,4" Margin="0,10,0,4"/>
                <ComboBox x:Name="CloudVoice" DisplayMemberPath="Label" SelectedValuePath="Id" Height="32"/>
                <CheckBox x:Name="AutomaticCloud" Content="允许 Auto Speak 将白名单应用的选区发送到 Azure" Margin="0,10,0,0"/>
                <TextBlock Text="选择 Azure 后，手动朗读会发送选区到 Azure；自动发送需要单独开启上方开关。" TextWrapping="Wrap" Foreground="#546575" Margin="0,6,0,0"/>
            </StackPanel>
            <StackPanel x:Name="EdgePanel" Visibility="Collapsed">
                <Grid Margin="0,12,0,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button x:Name="QueryEdgeVoices" Content="查询 / 刷新 Edge 在线语音" Click="QueryEdgeVoices_Click" HorizontalAlignment="Left" Padding="8,4"/>
                    <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"><Hyperlink x:Name="EdgeDiagnosticLink" Tag="Edge" Click="InlineDiagnostic_Click" Foreground="#193B56" TextDecorations="{x:Null}" ToolTip="检测已保存配置；实验性在线服务。">检测</Hyperlink></TextBlock>
                </Grid>
                <TextBlock Text="语言 / 地区筛选（例如 zh-CN、en-US；留空显示全部）" Margin="0,8,0,4"/>
                <TextBox x:Name="EdgeLocale" Height="28" TextChanged="EdgeLocale_Changed"/>
                <ComboBox x:Name="EdgeVoice" DisplayMemberPath="Label" SelectedValuePath="Id" Height="32" Margin="0,8,0,0" SelectionChanged="EdgeVoice_Changed"/>
                <TextBlock Text="Edge 音调（Hz；默认 0，仅影响 Edge）" Margin="0,12,0,4"/>
                <DockPanel><TextBlock DockPanel.Dock="Right" Width="56" Text="{Binding ElementName=EdgePitch, Path=Value, StringFormat=F0}"/><Slider x:Name="EdgePitch" Minimum="-100" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"/></DockPanel>
                <CheckBox x:Name="AutomaticEdge" Content="允许 Auto Speak 将白名单选区发送到 Edge（立即保存）" Click="AutomaticEdge_Click" Margin="0,10,0,0"/>
                <TextBlock Text="非官方在线接入，无需 Azure Key。手动朗读会将选中文字发送到微软在线服务；自动发送需要独立授权。接口可能变化而失效。这不是 Windows 已安装的离线 Natural Voices。" TextWrapping="Wrap" Foreground="#546575" Margin="0,6,0,0"/>
            </StackPanel>
            <StackPanel x:Name="MiMoPanel" Visibility="Collapsed">
                <Grid Margin="0,12,0,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="MiMo API Key（Windows 凭据管理器）" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"><Hyperlink x:Name="MiMoDiagnosticLink" Tag="MiMo" Click="InlineDiagnostic_Click" Foreground="#193B56" TextDecorations="{x:Null}" ToolTip="检测已保存配置；在线调用可能收费。">检测</Hyperlink></TextBlock>
                </Grid>
                <PasswordBox x:Name="MiMoKey" Height="28"/>
                <DockPanel Margin="0,8,0,0">
                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Hyperlink x:Name="MiMoApiKeyLink" NavigateUri="https://platform.xiaomimimo.com/console/api-keys" RequestNavigate="MiMoApiKey_RequestNavigate">获取 API Key</Hyperlink>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="保存 / 更新 Key" Tag="MiMo" Click="SaveHttpKey_Click" Padding="8,4" Margin="0,0,8,0"/>
                        <Button Content="清除 Key" Tag="MiMo" Click="ClearHttpKey_Click" Padding="8,4"/>
                    </StackPanel>
                </DockPanel>
                <TextBlock x:Name="MiMoCredentialStatus" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <TextBlock Text="Model（默认 mimo-v2.5-tts，可填写其他兼容模型名称）" Margin="0,10,0,4"/>
                <TextBox x:Name="MiMoModel" Height="28" MaxLength="200" TextChanged="MiMoModel_Changed"/>
                <CheckBox x:Name="MiMoStreaming" Content="流式播放（推荐）" Margin="0,10,0,0"/>
                <TextBlock x:Name="MiMoStreamingHint" TextWrapping="Wrap" Foreground="#546575" Margin="0,4,0,0"/>
                <TextBlock Text="预置音色（默认冰糖）" Margin="0,10,0,4"/>
                <ComboBox x:Name="MiMoVoice" Height="32"/>
                <TextBlock Text="整体风格标签（可多选；保存后生效）" Margin="0,10,0,4" FontWeight="SemiBold"/>
                <ItemsControl x:Name="MiMoSelectedStyles">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Button Tag="{Binding}" Click="RemoveMiMoStyle_Click"
                                ToolTip="点击或按空格移除此风格" Padding="8,4" Margin="0,0,6,6">
                            <TextBlock Text="{Binding StringFormat={}{0} ×}"/>
                        </Button>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="MiMoStylePrefix" TextWrapping="Wrap" Foreground="#193B56"/>
                <TextBlock x:Name="MiMoStyleHint" TextWrapping="Wrap" Foreground="#8A4D00" Margin="0,4,0,4"/>
                <Expander Header="浏览 / 搜索预设与添加自定义风格">
                    <StackPanel Margin="0,6,0,0">
                        <TextBlock Text="搜索风格名称或类别"/>
                        <TextBox x:Name="MiMoStyleSearch" Height="28" TextChanged="MiMoStyleSearch_Changed" Margin="0,4,0,6"/>
                        <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="MiMoPresetGroups"/>
                        </ScrollViewer>
                        <TextBlock Text="自定义风格（如上海话、说书腔、新闻播报；每项最多 64 字符）" TextWrapping="Wrap" Margin="0,6,0,4"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="添加" Click="AddMiMoStyle_Click" Padding="8,4" Margin="6,0,0,0"/>
                            <TextBox x:Name="MiMoCustomStyle" Height="28" KeyDown="MiMoCustomStyle_KeyDown"/>
                        </DockPanel>
                        <TextBlock x:Name="MiMoStyleError" TextWrapping="Wrap" Foreground="#8A4D00" Margin="0,4,0,0"/>
                    </StackPanel>
                </Expander>
                <Button Content="清空整体风格" Click="ClearMiMoStyles_Click" HorizontalAlignment="Left" Padding="8,4" Margin="0,6,0,0"/>
                <TextBlock Text="可选自然语言风格说明（最多 1000 字符）" Margin="0,10,0,4"/>
                <TextBox x:Name="MiMoStyle" AcceptsReturn="True" TextWrapping="Wrap" Height="65" MaxLength="1000"/>
                <TextBlock Text="自然语言说明独立发送，原样保留。可同时使用整体标签；矛盾风格可能影响效果。" TextWrapping="Wrap" Foreground="#546575" Margin="0,4,0,0"/>
                <CheckBox x:Name="AutomaticMiMo" Content="允许自动发送白名单选区到 MiMo（立即保存）" Click="AutomaticHttp_Click" Margin="0,10,0,0"/>
                <TextBlock Text="手动朗读会发送选中文字到小米，可能产生 API 费用。语速滑块转换为自然语言快慢指导，是近似控制，不保证精确倍速。原文保持不变。" TextWrapping="Wrap" Foreground="#546575" Margin="0,6,0,0"/>
            </StackPanel>
            <StackPanel x:Name="OpenAiPanel" Visibility="Collapsed">
                <TextBlock Text="Base URL（含 API 前缀，例如 https://api.openai.com/v1）" Margin="0,12,0,4"/>
                <TextBox x:Name="OpenAiBaseUrl" Height="28" TextChanged="OpenAiAddress_Changed"/>
                <Grid Margin="0,10,0,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="API Key（按服务地址存入 Windows 凭据管理器）" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"><Hyperlink x:Name="OpenAiDiagnosticLink" Tag="OpenAiTts" Click="InlineDiagnostic_Click" Foreground="#193B56" TextDecorations="{x:Null}" ToolTip="检测已保存配置；在线调用可能收费。">检测</Hyperlink></TextBlock>
                </Grid>
                <PasswordBox x:Name="OpenAiKey" Height="28"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="保存 / 更新 Key" Tag="OpenAi" Click="SaveHttpKey_Click" Padding="8,4" Margin="0,0,8,0"/>
                    <Button Content="清除 Key" Tag="OpenAi" Click="ClearHttpKey_Click" Padding="8,4"/>
                </StackPanel>
                <TextBlock x:Name="OpenAiCredentialStatus" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <TextBlock Text="Model" Margin="0,10,0,4"/><TextBox x:Name="OpenAiModel" Height="28" MaxLength="200"/>
                <TextBlock Text="Voice（可手工填写）" Margin="0,10,0,4"/><TextBox x:Name="OpenAiVoice" Height="28" MaxLength="200"/>
                <TextBlock Text="可选 Instructions（tts-1 / tts-1-hd 不支持，请留空）" Margin="0,10,0,4"/>
                <TextBox x:Name="OpenAiInstructions" AcceptsReturn="True" TextWrapping="Wrap" Height="65" MaxLength="4096"/>
                <CheckBox x:Name="AutomaticOpenAi" Content="允许自动发送到已保存地址（立即保存；先保存地址）" Click="AutomaticHttp_Click" Margin="0,10,0,0"/>
                <TextBlock Text="手动朗读会发送选中文字到配置的服务，可能产生 API 费用。远程地址须使用 HTTPS；本机回环可用 HTTP。修改地址会撤销自动授权，凭据按地址独立保存，须重新配置。第三方需支持 WAV 和 speed；不支持 Instructions 时请清空。" TextWrapping="Wrap" Foreground="#546575" Margin="0,6,0,0"/>
            </StackPanel>
            <Expander x:Name="LlmPanel" Header="AI 问答 · Ctrl+Alt+A（独立于 TTS）" Margin="0,18,0,0" IsExpanded="True">
                <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="主动按 Ctrl+Alt+A 或在 OCR 结果点击“问 AI”，会将问题和 System Prompt 发送至以下 LLM，可能产生费用。Auto Ask 仅在独立开关、应用规则和当前地址上传授权全部开启时自动发送选区。" TextWrapping="Wrap" Foreground="#8A4D00"/>
                    <TextBlock Text="LLM Base URL（HTTPS；本机回环允许 HTTP）" Margin="0,8,0,4"/>
                    <TextBox x:Name="LlmBaseUrl" MaxLength="2048" TextChanged="LlmAddress_Changed"/>
                    <TextBlock Text="Model（手工填写服务支持的模型）" Margin="0,8,0,4"/>
                    <TextBox x:Name="LlmModel" MaxLength="200"/>
                    <Grid Margin="0,8,0,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="LLM API Key（按地址隔离，与 TTS 凭据独立）" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"><Hyperlink x:Name="LlmDiagnosticLink" Tag="Llm" Click="InlineDiagnostic_Click" Foreground="#193B56" TextDecorations="{x:Null}" ToolTip="检测已保存配置；在线调用可能收费。">检测</Hyperlink></TextBlock>
                </Grid>
                    <PasswordBox x:Name="LlmKey"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                        <Button Content="保存 / 更新 LLM Key" Click="SaveLlmKey_Click" Padding="8,4" Margin="0,0,8,0"/>
                        <Button Content="清除 LLM Key" Click="ClearLlmKey_Click" Padding="8,4"/>
                    </StackPanel>
                    <TextBlock x:Name="LlmCredentialStatus" TextWrapping="Wrap"/>
                    <ComboBox x:Name="PromptChoice" SelectionChanged="PromptChoice_Changed" Margin="0,8,0,4"/>
                    <TextBox x:Name="PromptName" MaxLength="100" ToolTip="自定义预设名称"/>
                    <WrapPanel Margin="0,6,0,4">
                        <Button Content="保存为自定义预设" Click="AddPrompt_Click" Padding="8,4"/>
                        <Button Content="修改所选自定义预设" Click="UpdatePrompt_Click" Padding="8,4"/>
                        <Button Content="删除所选自定义预设" Click="DeletePrompt_Click" Padding="8,4"/>
                    </WrapPanel>
                    <TextBlock Text="预设与 Prompt 编辑后须点击底部保存设置才生效；内置预设始终保留。" TextWrapping="Wrap"/>
                    <TextBlock Text="System Prompt（可完全编辑或清空；最多 8192 字符）" Margin="0,8,0,4"/>
                    <TextBox x:Name="LlmSystemPrompt" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="100" MaxLength="8192"/>
                    <CheckBox x:Name="LlmStreaming" Content="Streaming · 流式显示回答" Margin="0,8,0,0"/>
                    <CheckBox x:Name="LlmAutoRead" Content="回答自动朗读（使用当前保存的 TTS）" Margin="0,8,0,0"/>
                    <ComboBox x:Name="LlmReadingStrategy" Margin="0,8,0,0">
                        <ComboBoxItem Content="完整回答后朗读（默认）"/>
                        <ComboBoxItem Content="边生成边逐句朗读（需 Streaming）"/>
                    </ComboBox>
                    <TextBlock Text="Thinking 协议（请确认服务及模型支持；拒绝时不自动重试）" Margin="0,8,0,4"/>
                    <ComboBox x:Name="ThinkingProtocolChoice" SelectionChanged="ThinkingProtocol_Changed">
                        <ComboBoxItem Content="不发送附加参数"/><ComboBoxItem Content="OpenAI reasoning_effort"/><ComboBoxItem Content="MiMo thinking.type"/>
                    </ComboBox>
                    <ComboBox x:Name="ThinkingOptionChoice" Margin="0,4,0,4"/>
                    <CheckBox x:Name="AutomaticLlm" Content="允许自动上传选区到当前已保存 LLM 地址（立即保存，可能收费）" Click="AutomaticLlm_Click" Margin="0,8,0,0"/>
                    <TextBlock x:Name="AutomaticLlmStatus" TextWrapping="Wrap"/>
                    <TextBlock Text="自动问答在线朗读还需独立 TTS 自动上传授权；未授权仅显示回答。更换 LLM 地址后须保存并重新授权。" TextWrapping="Wrap"/>
                    <TextBlock Text="在线 TTS 会将回答再次发送给所选 TTS 服务，可能另行收费。切换 LLM 地址须配置该地址的 Key。配置修改后点击底部“保存设置”；不兼容流式时可关闭 Streaming，主动重试，不自动重复请求。" TextWrapping="Wrap" Foreground="#546575" Margin="0,8,0,0"/>
                </StackPanel>
            </Expander>
            <TextBlock Text="语速（0.5–2 倍；MiMo 为近似指导）" Margin="0,18,0,4"/>
            <DockPanel><TextBlock DockPanel.Dock="Right" Width="46" Text="{Binding ElementName=Rate, Path=Value, StringFormat=F2}"/><Slider x:Name="Rate" Minimum="0.5" Maximum="2" TickFrequency="0.05" IsSnapToTickEnabled="True"/></DockPanel>
            <TextBlock Text="音量（0–1）" Margin="0,18,0,4"/>
            <DockPanel><TextBlock DockPanel.Dock="Right" Width="46" Text="{Binding ElementName=Volume, Path=Value, StringFormat=F2}"/><Slider x:Name="Volume" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True"/></DockPanel>
            <TextBlock Text="起始静音（0–250 ms）" Margin="0,18,0,4"/>
            <DockPanel><TextBlock DockPanel.Dock="Right" Width="65" Text="{Binding ElementName=StartupSilence, Path=Value, StringFormat={}{0:0} ms}"/><Slider x:Name="StartupSilence" Minimum="0" Maximum="250" TickFrequency="10" IsSnapToTickEnabled="True"/></DockPanel>
            <TextBlock Text="减少耳机起音缺失，默认 100 ms；0 表示关闭。保存后用于下一次朗读，逐句朗读每句都会增加此等待，暂停/继续不重复增加。" TextWrapping="Wrap" Foreground="#546575" Margin="0,6,0,0"/>
            <TextBlock Text="音频输出 · 点击多选（无需按 Ctrl），选择后须保存" Margin="0,18,0,4"/>
            <ListBox x:Name="Outputs" SelectionMode="Multiple" Height="110" DisplayMemberPath="Label" SelectionChanged="Outputs_Changed"/>
            <TextBlock x:Name="OutputSaveHint" Text="设备选择保存后用于下一次朗读。" TextWrapping="Wrap" Foreground="#8A4D00" Margin="0,6,0,0"/>
            <Button Content="刷新播放设备" Click="RefreshOutputs_Click" HorizontalAlignment="Left" Padding="8,4" Margin="0,6,0,0"/>
            <TextBlock Text="未选择时使用系统默认输出。部分设备不可用时跳过；全部不可用时回退默认输出并提示。" TextWrapping="Wrap" Foreground="#546575" Margin="0,6,0,0"/>
            <GroupBox x:Name="VirtualMicGroup" Header="虚拟麦克风" Margin="0,14,0,0">
                <StackPanel Margin="10">
                    <CheckBox x:Name="VirtualMicEnabled" Content="向虚拟麦克风同时输出（默认关闭；保存后生效）" Click="VirtualMicEnabled_Click"/>
                    <TextBlock Text="播放端点（Render）" Margin="0,8,0,3"/>
                    <ComboBox x:Name="VirtualRender" DisplayMemberPath="Label" SelectedValuePath="Id" SelectionChanged="VirtualPair_Changed"/>
                    <TextBlock Text="录音端点（Capture；在 Discord / OBS / Zoom 中选择它）" Margin="0,8,0,3"/>
                    <ComboBox x:Name="VirtualCapture" DisplayMemberPath="Label" SelectedValuePath="Id" SelectionChanged="VirtualPair_Changed"/>
                    <TextBlock x:Name="VirtualMicStatus" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <WrapPanel Margin="0,8,0,0">
                        <Button Content="重新扫描 / 自动检测" Click="VirtualScan_Click" Padding="8,4" Margin="0,0,8,4"/>
                        <Button x:Name="VirtualTestButton" Content="播放测试音并录音验证" Click="VirtualTest_Click" Padding="8,4" Margin="0,0,8,4"/>
                    </WrapPanel>
                    <TextBlock Text="首次选定须通过 3 秒固定音频录音验证；不录制物理麦克风。共享虚拟麦克风可能同时接收其他应用声音。关闭或更换已启用路由并保存会停止当前朗读；关闭后普通朗读排除此虚拟端点，不卸载驱动或更改默认麦克风。CLI / MCP 显式设备选择独立覆盖。" TextWrapping="Wrap" Foreground="#546575"/>
                </StackPanel>
            </GroupBox>
            <CheckBox x:Name="AutoStart" Content="登录 Windows 时启动（驻留托盘）" Margin="0,20,0,16"/>
            <CheckBox x:Name="AutoSpeak" Content="Auto Speak · 鼠标选中即朗读（立即保存）" Click="AutoSpeak_Click" Margin="0,0,0,10"/>
            <CheckBox x:Name="AutoAsk" Content="Auto Ask · 鼠标选中即问 AI（立即保存）" Click="AutoAsk_Click" Margin="0,0,0,10"/>
            <TextBlock Text="应用白名单：Ask 与 Speak 独立；同时启用时 Auto Ask 优先。仅使用 UIA 选区。" TextWrapping="Wrap"/>
            <TextBlock Text="自动操作应用白名单 · 仅使用 UIA 选区" FontWeight="SemiBold"/>
            <ListBox x:Name="Rules" Height="110" Margin="0,8,0,8" HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate><DataTemplate><DockPanel>
                    <CheckBox Content="Ask" IsChecked="{Binding AutoAsk, Mode=OneWay}" Click="AskRule_Click" DockPanel.Dock="Left" Margin="0,0,8,0"/>
                    <CheckBox Content="Speak" IsChecked="{Binding AutoSpeak, Mode=OneWay}" Click="Rule_Click" DockPanel.Dock="Left" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding ExecutablePath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ExecutablePath}"/>
                </DockPanel></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="AddApplication" Content="切换后添加前台应用" Click="AddApplication_Click" Padding="10,5" Margin="0,0,8,0"/>
                <Button Content="移除选中规则" Click="RemoveRule_Click" Padding="10,5"/>
            </StackPanel>
            <TextBlock x:Name="AutomaticStatus" TextWrapping="Wrap" Foreground="#546575" Margin="0,8,0,14"/>
            <TextBlock x:Name="Notice" TextWrapping="Wrap" Foreground="#8A4D00" Margin="0,12,0,0"/>
        </StackPanel></ScrollViewer>
        <StackPanel Grid.Row="2">
            <TextBlock x:Name="ProviderSaveHint" TextWrapping="Wrap" Foreground="#8A4D00" Margin="0,12,0,6"/>
            <TextBlock x:Name="StatusText" Text="空闲 · 就绪" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,8"/>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                <Button Content="暂停 / 继续" Click="Pause_Click" Padding="12,7" Margin="0,0,8,0"/>
                <Button Content="停止" Click="Stop_Click" Padding="12,7" Margin="0,0,8,0"/>
                <Button Content="退出" Click="Exit_Click" Padding="12,7"/>
                <Button Content="音频生成" Click="AudioWorkbench_Click" Padding="12,7" Margin="8,0,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="保存设置" Click="Save_Click" Padding="18,7" Margin="12,0,0,0"/>
            </Grid>
            <TextBlock Text="Ctrl+Alt+P 暂停/继续 · Ctrl+Alt+X 停止&#10;关闭此窗口后继续在托盘运行。" Foreground="#546575" Margin="0,12,0,0"/>
        </StackPanel>
    </Grid>
</Window>
